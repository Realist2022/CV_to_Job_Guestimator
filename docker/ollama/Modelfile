# Modelfile for the fine-tuned CV guestimator model.
#
# Export your fine-tuned GGUF build (e.g. from Unsloth) into this directory
# as cv-guestimator.gguf (gitignored — it never gets committed), then build
# with:  ollama create cv-guestimator-lora -f docker/ollama/Modelfile
#
# `ollama create -f` resolves FROM relative to this file, so this path stays
# portable across machines instead of pointing at one person's local export.
FROM ./cv-guestimator.gguf

# Increase context window to handle long CVs and Job Descriptions
PARAMETER num_ctx 8192

# Lower temperature for strict, analytical extraction 
PARAMETER temperature 0.1

# Optional but recommended: bake in your base system prompt
SYSTEM """You are an expert HR parsing assistant. Your job is to extract skills from CVs and Job Descriptions and output valid JSON."""
