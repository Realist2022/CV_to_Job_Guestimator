FROM python:3.12-slim

WORKDIR /app

# uv for dependency installation from the lockfile
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src/ src/
COPY configs/ configs/
# The one CV the deployed site matches against, with every detected PII
# value withheld (see scripts/build_serving_cv.py). Build fails without it
# rather than shipping a site that has no CV to compare anything to.
COPY serving/ serving/
COPY tasks/ tasks/
COPY main.py ./

ENV PATH="/app/.venv/bin:$PATH"

# Cloud Run injects PORT (8080) and health-checks exactly that port, so the
# port cannot be baked in. Shell form on purpose: the exec form would pass
# "$PORT" to uvicorn as a literal string. Defaults to 8000 so `docker run`
# and docker-compose behave as before.
ENV PORT=8000
EXPOSE 8000
CMD exec uvicorn src.api.app:app --host 0.0.0.0 --port ${PORT}
